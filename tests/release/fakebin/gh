#!/usr/bin/env bash
# Fake gh. Never performs a network call; records what would have happened.
set -euo pipefail
source "$(dirname "$0")/_fakelib.sh"

case "${1:-} ${2:-}" in
  "auth status") exit "${FAKE_GH_AUTH_RC:-0}" ;;
  "repo view")   echo '{"nameWithOwner":"Niko96-dotcom/SendBloom"}'
                 [[ "$*" == *"-q .nameWithOwner"* ]] && { echo; }
                 exit 0 ;;
esac

if [[ "${1:-}" == "repo" && "${2:-}" == "view" ]]; then
  if [[ "$*" == *"nameWithOwner"* ]]; then echo "Niko96-dotcom/SendBloom"; fi
  exit 0
fi

if [[ "${1:-}" == "release" ]]; then
  case "${2:-}" in
    view)
      fake_log "gh:release-view ${3:-}"
      exit "${FAKE_GH_RELEASE_VIEW_RC:-1}" ;;
    create)
      fake_log "gh:release-create ${3:-}"
      exit "${FAKE_GH_RELEASE_CREATE_RC:-0}" ;;
    download)
      fake_log "gh:release-download ${3:-}"
      exit "${FAKE_GH_RELEASE_DOWNLOAD_RC:-0}" ;;
  esac
fi
exit 0
